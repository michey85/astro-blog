---
import { getEntry } from "astro:content";

// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1);

// Human-readable labels for top-level URL segments
const LABELS: Record<string, string> = {
  posts: "Посты",
  tags: "Теги",
  rubrics: "Рубрики",
  about: "Обо мне",
  search: "Поиск",
};
const decode = (segment: string) => {
  try {
    return decodeURIComponent(segment);
  } catch {
    return segment;
  }
};
const label = (segment: string) => LABELS[segment] ?? decode(segment);

// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
breadcrumbList[0] === "posts" &&
  breadcrumbList.splice(0, 2, `Посты (стр. ${breadcrumbList[1] || 1})`);

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with [tag] (page number)
breadcrumbList[0] === "tags" &&
  !isNaN(Number(breadcrumbList[2])) &&
  breadcrumbList.splice(
    1,
    3,
    `${breadcrumbList[1]} ${
      Number(breadcrumbList[2]) === 1 ? "" : "(стр. " + breadcrumbList[2] + ")"
    }`
  );

// if breadcrumb is Home > Rubrics > [rubric] > [page]
// replace [rubric] > [page] with the rubric title (page number)
// The title is free-form CMS text, not a URL segment: it is rendered as is,
// never decoded or looked up in LABELS.
let rubricCrumb: string | undefined;
if (breadcrumbList[0] === "rubrics" && breadcrumbList[1]) {
  const rubric = await getEntry("rubrics", breadcrumbList[1]);
  const page = Number(breadcrumbList[2]);
  rubricCrumb = `${rubric?.data.title ?? decode(breadcrumbList[1])}${page > 1 ? ` (стр. ${page})` : ""}`;
  breadcrumbList.splice(1, 2, rubricCrumb);
}
---

<nav class="breadcrumb" aria-label="Навигационная цепочка">
  <ul>
    <li>
      <a href="/">Главная</a>
      <span aria-hidden="true">&raquo;</span>
    </li>
    {breadcrumbList.map((breadcrumb, index) =>
      index + 1 === breadcrumbList.length ? (
        <li>
          <span
            class={rubricCrumb ? "" : index > 0 ? "lowercase" : "capitalize"}
            aria-current="page"
          >
            {/* make the last part lowercase in Home > Tags > some-tag */}
            {rubricCrumb ?? label(breadcrumb)}
          </span>
        </li>
      ) : (
        <li>
          <a href={`/${breadcrumb}/`}>{label(breadcrumb)}</a>
          <span aria-hidden="true">&raquo;</span>
        </li>
      )
    )}
  </ul>
</nav>

<style>
  @reference "../styles/base.css";
  /*
   * Components layer, so utility classes in the markup still win (as in Tailwind 3).
   * The order statement keeps layers correct even if this <style> is emitted
   * before the main stylesheet.
   */
  @layer theme, base, components, utilities;
  @layer components {
    .breadcrumb {
      @apply mx-auto mb-1 mt-8 w-full max-w-3xl px-4;
    }
    .breadcrumb ul li {
      @apply inline;
    }
    .breadcrumb ul li a {
      @apply capitalize opacity-70;
    }
    .breadcrumb ul li span {
      @apply opacity-70;
    }
    .breadcrumb ul li:not(:last-child) a {
      @apply hover:opacity-100;
    }
  }
</style>
