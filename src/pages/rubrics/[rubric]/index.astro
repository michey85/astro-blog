---
import { getCollection } from "astro:content";
import RubricPosts from "@layouts/RubricPosts.astro";
import getPagination from "@utils/getPagination";
import { getPostsByRubric, getRubrics } from "@utils/rubrics";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const rubrics = await getRubrics();

  return rubrics.map(rubric => ({
    params: { rubric: rubric.id },
    props: { rubric, posts },
  }));
}

const { rubric, posts } = Astro.props;

const pagination = getPagination({
  posts: getPostsByRubric(posts, rubric.id),
  page: 1,
  isIndex: true,
});
---

<RubricPosts {...pagination} {rubric} />
