---
import { getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";

export async function getStaticPaths() {
  // Slugs already taken by built-in routes; CMS pages with these slugs are skipped.
  const RESERVED_SLUGS = ["posts", "tags", "search", "404"];
  const pages = await getCollection(
    "pages",
    ({ data, id }) => !data.draft && !RESERVED_SLUGS.includes(id)
  );
  return pages.map(page => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<PageLayout
  title={page.data.title}
  description={page.data.description}
  slug={page.id}
>
  <Content />
</PageLayout>
