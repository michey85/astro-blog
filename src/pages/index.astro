---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import getThumbnail from "@utils/getThumbnail";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { z } from "astro/zod";
import { SITE, SOCIALS } from "@config";
import { Content as HomeIntro, frontmatter } from "../data/home.md";
import {
  Content as HomeMiddle,
  rawContent as homeMiddleRaw,
} from "../data/home-middle.md";
import {
  Content as HomeBottom,
  rawContent as homeBottomRaw,
} from "../data/home-bottom.md";

// home.md is edited via Pages CMS ("Home page"); fall back to the site title
// if the heading is missing or blank.
const home = z
  .object({ title: z.string().trim().min(1).optional().catch(undefined) })
  .parse(frontmatter ?? {});
const heroTitle = home.title ?? SITE.title;

// Optional text blocks, edited via Pages CMS ("Home page: ..."); an empty
// file renders nothing.
const hasMiddleText = homeMiddleRaw().trim().length > 0;
const hasBottomText = homeBottomRaw().trim().length > 0;

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

// Only the cards shown below get thumbnails: all featured + first 4 recent
const thumbnails = new Map(
  await Promise.all(
    [...featuredPosts, ...recentPosts.slice(0, 4)].map(
      async p => [p.id, await getThumbnail(p.data)] as const
    )
  )
);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>{heroTitle}</h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="RSS-лента"
        title="RSS-лента"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon">
          <path d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"></path>
          <path d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"></path>
          <circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS-лента</span>
      </a>

      <div class="home-text">
        <HomeIntro />
      </div>
      {
        // only display if at least one social link is enabled
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">Соцсети:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    {featuredPosts.length > 0 && (
      <section id="featured">
        <h2>Избранное</h2>
        <ul>
          {featuredPosts.map(({ data, id }) => (
            <Card
              href={`/posts/${id}/`}
              frontmatter={data}
              thumbnail={thumbnails.get(id)}
              secHeading={false}
            />
          ))}
        </ul>
      </section>
    )}

    {hasMiddleText && (
      <div class="home-text home-text-middle">
        <HomeMiddle />
      </div>
    )}

    {featuredPosts.length > 0 && recentPosts.length > 0 && <Hr />}

    {recentPosts.length > 0 && (
      <section id="recent-posts">
        <h2>Последние посты</h2>
        <ul>
          {recentPosts.map(
            ({ data, id }, index) =>
              index < 4 && (
                <Card
                  href={`/posts/${id}/`}
                  frontmatter={data}
                  thumbnail={thumbnails.get(id)}
                  secHeading={false}
                />
              )
          )}
        </ul>
      </section>
    )}

    <div class="all-posts-btn-wrapper">
      <LinkButton href="/posts/">
        Все посты
        <svg xmlns="http://www.w3.org/2000/svg">
          <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"></path>
        </svg>
      </LinkButton>
    </div>

    {hasBottomText && (
      <div class="home-text home-text-bottom">
        <HomeBottom />
      </div>
    )}
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";
  /*
   * Components layer, so utility classes in the markup still win (as in Tailwind 3).
   * The order statement keeps layers correct even if this <style> is emitted
   * before the main stylesheet.
   */
  @layer theme, base, components, utilities;
  @layer components {
    /* ===== Hero Section ===== */
    #hero {
      @apply pt-8 pb-6;
    }
    #hero h1 {
      @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
    }
    #hero .rss-link {
      @apply mb-6;
    }
    #hero .rss-icon {
      @apply fill-skin-accent mb-2 h-6 w-6 scale-110 sm:mb-3 sm:scale-125;
    }
    .home-text :global(p) {
      @apply my-2;
    }
    .home-text :global(a) {
      @apply hover:text-skin-accent underline decoration-dashed underline-offset-4;
    }
    .social-wrapper {
      @apply mt-4 flex flex-col sm:flex-row sm:items-center;
    }
    .social-links {
      @apply mr-2 mb-1 whitespace-nowrap sm:mb-0;
    }

    /* ===== Featured & Recent Posts Sections ===== */
    #featured,
    #recent-posts {
      @apply pt-12 pb-6;
    }
    #featured h2,
    #recent-posts h2 {
      @apply text-2xl font-semibold tracking-wide;
    }
    .all-posts-btn-wrapper {
      @apply my-8 text-center;
    }

    /* ===== Optional text blocks (home-middle.md, home-bottom.md) ===== */
    .home-text-middle {
      @apply pb-6;
    }
    .home-text-bottom {
      @apply mb-8;
    }
  }
</style>
