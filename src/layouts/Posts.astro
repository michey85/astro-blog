---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import getThumbnail from "@utils/getThumbnail";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;

const thumbnails = new Map(
  await Promise.all(
    paginatedPosts.map(async p => [p.id, await getThumbnail(p.data)] as const)
  )
);
---

<Layout title={`Посты | ${SITE.title}`}>
  <Header activeNav="posts" />
  <Main pageTitle="Посты" pageDesc="Все опубликованные статьи.">
    <ul>
      {paginatedPosts.map(({ data, id }) => (
        <Card
          href={`/posts/${id}/`}
          frontmatter={data}
          thumbnail={thumbnails.get(id)}
        />
      ))}
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
    nextUrl={`/posts/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
