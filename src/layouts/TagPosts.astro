---
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import getThumbnail from "@utils/getThumbnail";
import Pagination from "@components/Pagination.astro";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, paginatedPosts, tag, tagName } = Astro.props;

const thumbnails = new Map(
  await Promise.all(
    paginatedPosts.map(async p => [p.id, await getThumbnail(p.data)] as const)
  )
);
---

<Layout title={`Тег: ${tagName} | ${SITE.title}`}>
  <Header activeNav="tags" />
  <Main
    pageTitle={[`Тег:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`Все статьи с тегом «${tagName}».`}
  >
    <h1 slot="title" transition:name={tag}>{`Тег:${tag}`}</h1>
    <ul>
      {paginatedPosts.map(({ data, id }) => (
        <Card
          href={`/posts/${id}/`}
          frontmatter={data}
          thumbnail={thumbnails.get(id)}
        />
      ))}
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/tags/${tag}${
      currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
    }/`}
    nextUrl={`/tags/${tag}/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
