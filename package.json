{
  "name": "astro-paper",
  "version": "4.2.0",
  "private": false,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && jampack ./dist",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check . --plugin=prettier-plugin-astro",
    "format": "prettier --write . --plugin=prettier-plugin-astro",
    "cz": "cz",
    "prepare": "husky",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/rss": "^4.0.19",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.12",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@divriots/jampack": "^0.35.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/github-slugger": "^1.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-eslint-parser": "^3.2.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript-eslint": "^8.72.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,astro}": [
      "prettier --write --plugin=prettier-plugin-astro"
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@swc/core@1.16.22": true,
    "fsevents@2.3.3": true
  }
}
